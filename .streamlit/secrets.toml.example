# Copy to .streamlit/secrets.toml (git-ignored) or paste into Streamlit Cloud > Settings > Secrets.
# The app stays in demo mode unless BOTH of these are set AND the viewer enters
# LIVE_MODE_PASSWORD in the sidebar. Leave them unset for a demo-only deployment.
ANTHROPIC_API_KEY = "your-key-here"
LIVE_MODE_PASSWORD = "choose-a-long-random-password"

# Optional overrides (defaults shown).
# POLICYLAB_MODEL = "claude-sonnet-5-5"
# POLICYLAB_EFFORT = "medium"
